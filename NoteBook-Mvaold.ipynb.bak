    "import pandas as pd\n",
    "# Homogénéisation des identifiants de machine\n",
    "df = pd.read_csv(\"C:\\\\Formation\\\\capteurs_temperature.csv\",sep=\";\",parse_dates=[\"timestamp\"])\n",
    "df['machine_id'] = df['machine_id'].str.replace('MACH-', 'MACH_', regex=False)\n",
    "dfi = pd.read_csv(\"C:\\\\Formation\\\\releves_incidents.csv\",sep=\",\")\n",
    "dfi['machine_id'] = dfi['machine_id'].str.replace('M-', 'MACH_', regex=False)\n",
    "\n",
    "#2025-12-06T02:00:00+01:00\n",
    "dfp = pd.read_csv(\"C:\\\\Formation\\\\capteurs_pression.tsv\",sep=\"\\t\")\n",
    "dfp['timestamp'] = dfp['timestamp'].str.replace('T', ' ', regex=False).str.replace('+01:00', '', regex=False)\n",
    "\n",
    "# Affichage des premières lignes pour vérifier le changement\n",
    "print(df.head())"
   ]
