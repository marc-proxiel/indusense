  {
   "cell_type": "markdown",
   "id": "dcb1c2a9",
   "metadata": {},
   "source": [
    "# ORM\n",
    "Génération d'un MCD à partir des 3 fichiers voir MCD.drawio.\n",
    "Cela permet de générer un script sql de création de la base :\n",
    "\n",
    "Voici un script SQL généré à partir du Modèle Conceptuel de Données (MCD) fourni dans les sources\n",
    ". Ce script définit les tables, les colonnes, les types de données et les contraintes d'intégrité référentielle (clés étrangères).\n",
    "-- Création de la table Machine\n",
    "-- Table Machine\n",
    "CREATE TABLE Machine (\n",
    "    ID BIGINT PRIMARY KEY NOT NULL, -- PK long not null\n",
    "    Nom VARCHAR(255) NOT NULL       -- string not null\n",
    ");\n",
    "\n",
    "-- Table Operateur\n",
    "CREATE TABLE Operateur (\n",
    "    ID BIGINT PRIMARY KEY NOT NULL, -- PK long not null\n",
    "    Nom VARCHAR(255) NOT NULL       -- string not null\n",
    ");\n",
    "\n",
    "-- Table Capteur (Liée à Machine)\n",
    "CREATE TABLE Capteur (\n",
    "    ID BIGINT PRIMARY KEY NOT NULL, -- PK long not null\n",
    "    Nom VARCHAR(255) NOT NULL,      -- string not null\n",
    "    Type INTEGER NULL,              -- int null\n",
    "    Unit VARCHAR(50) NULL,          -- string null\n",
    "    Machine_ID BIGINT NOT NULL,\n",
    "    CONSTRAINT fk_machine FOREIGN KEY (Machine_ID) REFERENCES Machine(ID)\n",
    ");\n",
    "\n",
    "-- Table Incident (Liée à Machine et Operateur)\n",
    "-- Changement : Lien direct avec Machine 1 <-> 0..n [1]\n",
    "CREATE TABLE Incident (\n",
    "    ID BIGINT PRIMARY KEY NOT NULL,   -- PK long not null\n",
    "    Date TIMESTAMP NOT NULL,          -- datetime not null\n",
    "    severite SMALLINT NULL,           -- short null\n",
    "    Commentaire TEXT NULL,            -- string null\n",
    "    quarter SMALLINT NULL,            -- short null\n",
    "    Machine_ID BIGINT NOT NULL,\n",
    "    Operateur_ID BIGINT NOT NULL,\n",
    "    CONSTRAINT fk_machine_incident FOREIGN KEY (Machine_ID) REFERENCES Machine(ID),\n",
    "    CONSTRAINT fk_operateur_incident FOREIGN KEY (Operateur_ID) REFERENCES Operateur(ID)\n",
    ");\n",
    "\n",
    "-- Table Mesure (Liée à Capteur)\n",
    "CREATE TABLE Mesure (\n",
    "    ID BIGINT PRIMARY KEY NOT NULL,   -- PK long not null\n",
    "    Valeur DOUBLE PRECISION NULL,     -- double null\n",
    "    Date TIMESTAMP NULL,              -- datetime null\n",
    "    Capteur_ID BIGINT NOT NULL,\n",
    "    CONSTRAINT fk_capteur_mesure FOREIGN KEY (Capteur_ID) REFERENCES Capteur(ID)\n",
    ");\n",
    "Détails de l'implémentation basés sur le MCD\n",
    " :\n",
    "Clés Primaires (PK) : Toutes les entités possèdent un identifiant de type long (traduit ici par BIGINT)\n",
    ".\n",
    "Gestion des relations :\n",
    "La table Capteur inclut une clé étrangère vers Machine car une machine peut posséder plusieurs capteurs\n",
    ".\n",
    "La table Incident intègre des clés étrangères vers Operateur et Machine pour refléter les liens hiérarchiques et d'association définis dans le schéma\n",
    ".\n",
    "La table Mesure est rattachée au Capteur correspondant\n",
    ".\n",
    "Types de données : Les types string, int, short, double et datetime ont été convertis vers leurs équivalents SQL standards (VARCHAR, INTEGER, SMALLINT, DOUBLE PRECISION, TIMESTAMP)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "405bb103",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sqlalchemy import create_engine, Column, Integer, BigInteger, String, Float, DateTime, ForeignKey, SmallInteger, Text\n",
    "from sqlalchemy.orm import declarative_base, relationship, sessionmaker\n",
    "\n",
    "Base = declarative_base()\n",
    "\n",
    "class Machine(Base):\n",
    "    __tablename__ = 'machine'\n",
    "    id = Column(BigInteger, primary_key=True) # ID (PK long not null) [1]\n",
    "    nom = Column(String, nullable=False)      # Nom (string not null) [1]\n",
    "    \n",
    "    capteurs = relationship(\"Capteur\", back_populates=\"machine\")\n",
    "    incidents = relationship(\"Incident\", back_populates=\"machine\") # Nouveau lien [1]\n",
    "\n",
    "class Operateur(Base):\n",
    "    __tablename__ = 'operateur'\n",
    "    id = Column(BigInteger, primary_key=True)\n",
    "    nom = Column(String, nullable=False)\n",
    "    incidents = relationship(\"Incident\", back_populates=\"operateur\")\n",
    "\n",
    "class Capteur(Base):\n",
    "    __tablename__ = 'capteur'\n",
    "    id = Column(BigInteger, primary_key=True)\n",
    "    nom = Column(String, nullable=False)\n",
    "    type = Column(Integer)\n",
    "    unit = Column(String)\n",
    "    machine_id = Column(BigInteger, ForeignKey('machine.id'), nullable=False)\n",
    "    \n",
    "    machine = relationship(\"Machine\", back_populates=\"capteurs\")\n",
    "    mesures = relationship(\"Mesure\", back_populates=\"capteur\")\n",
    "\n",
    "class Incident(Base):\n",
    "    __tablename__ = 'incident'\n",
    "    id = Column(BigInteger, primary_key=True)\n",
    "    date = Column(DateTime, nullable=False)    # Date (datetime not null) [1]\n",
    "    severite = Column(SmallInteger)            # severite (short null) [1]\n",
    "    commentaire = Column(Text)                 # Commentaire (string null) [1]\n",
    "    quarter = Column(SmallInteger)             # quarter (short null) [1]\n",
    "    \n",
    "    # Relations d'après le nouveau schéma [1]\n",
    "    machine_id = Column(BigInteger, ForeignKey('machine.id'), nullable=False)\n",
    "    operateur_id = Column(BigInteger, ForeignKey('operateur.id'), nullable=False)\n",
    "    \n",
    "    machine = relationship(\"Machine\", back_populates=\"incidents\")\n",
    "    operateur = relationship(\"Operateur\", back_populates=\"incidents\")\n",
    "\n",
    "class Mesure(Base):\n",
    "    __tablename__ = 'mesure'\n",
    "    id = Column(BigInteger, primary_key=True)\n",
    "    valeur = Column(Float)                     # Valeur (double null) [1]\n",
    "    date = Column(DateTime)                    # Date (datetime null) [1]\n",
    "    capteur_id = Column(BigInteger, ForeignKey('capteur.id'), nullable=False)\n",
    "    \n",
    "    capteur = relationship(\"Capteur\", back_populates=\"mesures\")\n",
    "\n",
    "# Connexion à la base de données (exemple avec SQLite pour le test)\n",
    "# engine = create_engine('sqlite:///indusense.db')\n",
    "\n",
    "# --- CONNEXION POSTGRESQL DANS DOCKER ---\n",
    "\n",
    "# Remplacez par vos identifiants Docker\n",
    "USER = \"dbuser\"\n",
    "PASSWORD = \"dbpassword\"\n",
    "HOST = \"localhost\" # Ou le nom du service si le script est aussi dans Docker\n",
    "PORT = \"5432\"\n",
    "DB_NAME = \"mydb\"\n",
    "\n",
    "DATABASE_URL = f\"postgresql://{USER}:{PASSWORD}@{HOST}:{PORT}/{DB_NAME}\"\n",
    "\n",
    "# engine = create_engine(DATABASE_URL)\n",
    "engine = create_engine(\"postgresql+psycopg://dbuser:dbpassword@localhost:5432/mydb\")\n",
    "# Création des tables dans PostgreSQL\n",
    "Base.metadata.create_all(engine)"
   ]
  },
