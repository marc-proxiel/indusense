    "import pandas as pd\n",
    "df = pd.read_csv(\"C:\\\\Formation\\\\capteurs_temperature.csv\",sep=\";\",parse_dates=[\"timestamp\"])\n",
    "dfp = pd.read_csv(\"C:\\\\Formation\\\\capteurs_pression.tsv\",sep=\"\\t\",parse_dates=[\"timestamp\"])\n",
    "# Compter les doublons\n",
    "print(f\"Nombre de doublons temperatures: {df.duplicated().sum()}\")\n",
    "print(f\"Nombre de doublons pression: {dfp.duplicated().sum()}\")\n",
    "\n",
    "# Voir les lignes en doublon\n",
    "# print(\"doublons temperatures:\")\n",
    "#print(df[df.duplicated(keep=False)])\n",
    "#print(\"doublons pressions:\")\n",
    "#print(dfp[dfp.duplicated(keep=False)])\n",
    "# types des colonnes\n",
    "# print(df.dtypes)\n",
    "print(\"infos temperatures:\")\n",
    "df.info()\n",
    "print(\"infos pressions:\")\n",
    "dfp.info()\n",
    "\n",
    "# Voir si une colonne contient des types mixtes\n",
    "df.apply(lambda col: col.apply(type).unique())\n",
    "\n",
    "# Convertir les types en chaînes de caractères avant value_counts()\n",
    "# df.apply(lambda col: col.apply(type).astype(str).value_counts())\n",
    "\n",
    "# Chercher les incohérences (valeurs qui ne correspondent pas au type)\n",
    "for col in df.columns:\n",
    "    types_uniques = df[col].apply(type).unique()\n",
    "    if len(types_uniques) > 1:\n",
    "        print(f\"Incohérence dans '{col}': {types_uniques}\")\n",
    "\n",
    "# les valeurs extremes de date \n",
    "for col in df.select_dtypes(include='datetime').columns:\n",
    "    print(col, df[col].min(), df[col].max()) \n",
    "# les valeurs extremes de date \n",
    "for col in dfp.select_dtypes(include='datetime').columns:\n",
    "    print(col, dfp[col].min(), dfp[col].max())\n",
    "\n",
    "for col in df.select_dtypes(include='number').columns:\n",
    "    print(col)\n",
    "    print(\" temperature min:\", df[col].min())\n",
    "    print(\" temperature max:\", df[col].max())\n",
    "for col in dfp.select_dtypes(include='number').columns:\n",
    "    print(col)\n",
    "    print(\" pression min:\", dfp[col].min())\n",
    "    print(\" pression max:\", dfp[col].max())\n",
    "\n",
    "# Obtenir la moyenne d'une colonne spécifique\n",
    "moyennet = df['temperature'].mean()\n",
    "print(f\"moyenne des temperatures : {moyennet}\")\n",
    "moyennep = dfp['pressure_bar'].mean()\n",
    "print(f\"moyenne des pressions : {moyennep}\")          \n",
    "\n",
    "# Obtenir la médiane d'une colonne spécifique\n",
    "medianet = df['temperature'].median()\n",
    "print(f\"mediane des temperatures : {medianet}\")\n",
    "medianep = dfp['pressure_bar'].median()\n",
    "print(f\"mediane des pressions : {medianep}\")          "
   ]
